<section class="space-y-8">
  <div class="rounded-3xl border border-slate-200 bg-white px-8 py-10 shadow-sm">
    <div class="flex flex-col gap-6 xl:flex-row xl:items-start xl:justify-between">
      <div class="max-w-3xl space-y-4">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-700">HP Agreement</p>
        <div class="space-y-3">
          <h1 class="text-4xl font-semibold tracking-tight text-slate-900">Prepare the agreement from the data you already trust.</h1>
          <p class="text-lg text-slate-600">This step is intentionally light-touch. The customer, vehicle, and core finance values come from <span class="font-semibold text-slate-900"><%= @broker_application.application_reference %></span>; the user only supplies agreement-specific details that have not been captured yet.</p>
        </div>
      </div>

      <div class="rounded-2xl border border-sky-100 bg-sky-50 px-5 py-4 text-sm text-slate-700 xl:max-w-sm">
        <p class="font-semibold text-slate-900">Why this matters</p>
        <p class="mt-2">Minimizing duplicate entry reduces avoidable admin time and gives later reconciliation screens a cleaner baseline-versus-agreement comparison.</p>
      </div>
    </div>
  </div>

  <%= render "form", broker_application: @broker_application, broker_hp_agreement: @broker_hp_agreement %>
</section>
