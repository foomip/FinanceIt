<section class="space-y-8">
  <div class="rounded-3xl border border-emerald-200 bg-emerald-50 px-8 py-8 shadow-sm">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-700">Purchase Invoice Captured</p>
        <h1 class="mt-2 text-4xl font-semibold tracking-tight text-slate-900"><%= @broker_application.application_reference %></h1>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-700">The dealer invoice is now stored as its own source snapshot. Later reconciliation can compare it against intake and the HP agreement without forcing the user to keep re-reading PDFs.</p>
      </div>

      <div class="flex gap-3">
        <%= link_to 'View application', broker_application_path(@broker_application), class: 'inline-flex items-center justify-center rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900' %>
        <%= link_to 'View HP agreement', broker_application_hp_agreement_path(@broker_application), class: 'inline-flex items-center justify-center rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900' %>
        <%= link_to 'Return to dashboard', dashboard_path, class: 'inline-flex items-center justify-center rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800' %>
      </div>
    </div>
  </div>

  <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="mb-6 flex items-start justify-between gap-4">
      <div>
        <h2 class="text-2xl font-semibold text-slate-900">Invoice summary</h2>
        <p class="mt-2 text-sm text-slate-600">This is the dealer-facing version of the deal, ready for future field-by-field reconciliation against the earlier snapshots.</p>
      </div>
      <span class="rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-sky-700">Source snapshot</span>
    </div>

    <div class="grid gap-6 xl:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
        <h3 class="text-lg font-semibold text-slate-900">Header</h3>
        <dl class="mt-4 space-y-3 text-sm text-slate-600">
          <div>
            <dt class="font-medium text-slate-900">Supplier</dt>
            <dd class="mt-1"><%= @broker_purchase_invoice.supplier_name %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-900">Invoice number</dt>
            <dd class="mt-1"><%= @broker_purchase_invoice.invoice_number %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-900">Date</dt>
            <dd class="mt-1"><%= @broker_purchase_invoice.invoice_date.strftime('%d/%m/%Y') %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-900">Addressed to</dt>
            <dd class="mt-1"><%= @broker_purchase_invoice.addressed_to %></dd>
          </div>
        </dl>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
        <h3 class="text-lg font-semibold text-slate-900">Customer and vehicle</h3>
        <dl class="mt-4 space-y-3 text-sm text-slate-600">
          <div>
            <dt class="font-medium text-slate-900">Customer</dt>
            <dd class="mt-1"><%= @broker_purchase_invoice.customer_name %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-900">Address</dt>
            <dd class="mt-1"><%= @broker_purchase_invoice.customer_address %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-900">Make / model</dt>
            <dd class="mt-1"><%= @broker_purchase_invoice.make_model %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-900">Registration</dt>
            <dd class="mt-1"><%= @broker_purchase_invoice.registration %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-900">Mileage at sale</dt>
            <dd class="mt-1"><%= number_with_delimiter(@broker_purchase_invoice.mileage_at_sale) %></dd>
          </div>
        </dl>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
        <h3 class="text-lg font-semibold text-slate-900">Pricing and finance</h3>
        <dl class="mt-4 space-y-3 text-sm text-slate-600">
          <div>
            <dt class="font-medium text-slate-900">Vehicle price</dt>
            <dd class="mt-1"><%= number_to_currency(@broker_purchase_invoice.vehicle_price) %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-900">Administration fee</dt>
            <dd class="mt-1"><%= number_to_currency(@broker_purchase_invoice.administration_fee) %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-900">Delivery charge</dt>
            <dd class="mt-1"><%= number_to_currency(@broker_purchase_invoice.delivery_charge) %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-900">Invoice total</dt>
            <dd class="mt-1"><%= number_to_currency(@broker_purchase_invoice.invoice_total) %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-900">Deposit received</dt>
            <dd class="mt-1"><%= number_to_currency(@broker_purchase_invoice.deposit_received) %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-900">Amount to finance</dt>
            <dd class="mt-1"><%= number_to_currency(@broker_purchase_invoice.amount_to_finance) %></dd>
          </div>
          <div>
            <dt class="font-medium text-slate-900">Finance company</dt>
            <dd class="mt-1"><%= @broker_purchase_invoice.finance_company %></dd>
          </div>
        </dl>
      </article>
    </div>
  </section>

  <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <h2 class="text-2xl font-semibold text-slate-900">VAT note</h2>
    <p class="mt-4 text-sm leading-6 text-slate-600"><%= @broker_purchase_invoice.vat_note %></p>
  </section>
</section>
