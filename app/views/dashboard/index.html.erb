<section class="w-full space-y-8">
  <div class="rounded-3xl border border-slate-200 bg-white px-8 py-10 shadow-sm">
    <div class="flex flex-col gap-8 xl:flex-row xl:items-start xl:justify-between">
      <div class="max-w-3xl space-y-4">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-700">InsureIt Prototype</p>
        <div class="space-y-3">
          <h1 class="text-4xl font-semibold tracking-tight text-slate-900">Start with structured intake, then automate everything after it.</h1>
          <p class="text-lg text-slate-600">The first live slice captures the broker application as normalized deal data. That removes re-keying later and gives the reconciliation engine a trustworthy baseline to compare against the agreement, invoice, mandate, and external checks.</p>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <%= link_to "Capture broker application", new_broker_application_path, class: "inline-flex items-center justify-center rounded-full bg-slate-950 px-6 py-3 text-sm font-semibold text-white transition hover:bg-slate-800" %>
          <p class="text-sm text-slate-500">Use the sample deal reference <span class="font-semibold text-slate-700">AF-2026-00417</span> to seed the prototype flow.</p>
        </div>
      </div>

      <aside class="grid gap-4 lg:w-88">
        <div class="rounded-2xl border border-sky-100 bg-sky-50 px-5 py-4 text-sm text-slate-700">
          <p class="font-semibold text-slate-900">Signed in as</p>
          <p class="mt-2 break-all font-medium"><%= current_user.email %></p>
          <p class="mt-3 inline-flex rounded-full bg-white px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-sky-700">
            <%= current_user.role_name.humanize %>
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-950 px-5 py-4 text-white">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-300">Captured applications</p>
          <p class="mt-3 text-4xl font-semibold"><%= @recent_broker_applications.size %></p>
          <p class="mt-2 text-sm text-slate-300">Recent submissions visible on this dashboard for quick return-to-work context.</p>
        </div>
      </aside>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <% @sections.each do |section| %>
      <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between gap-4">
          <h2 class="text-xl font-semibold text-slate-900"><%= section[:title] %></h2>
          <span class="rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] <%= section[:status] == "Live" ? "bg-emerald-100 text-emerald-800" : section[:status] == "Next" ? "bg-sky-100 text-sky-800" : "bg-amber-100 text-amber-800" %>"><%= section[:status] %></span>
        </div>
        <p class="mt-4 text-sm leading-6 text-slate-600"><%= section[:summary] %></p>
      </article>
    <% end %>
  </div>

  <div class="grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h2 class="text-2xl font-semibold text-slate-900">Recent broker applications</h2>
          <p class="mt-2 text-sm text-slate-600">Internal users should be able to resume the most recent deals without searching through raw documents.</p>
        </div>
        <%= link_to "New capture", new_broker_application_path, class: "inline-flex items-center justify-center rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900" %>
      </div>

      <% if @recent_broker_applications.any? %>
        <div class="mt-6 space-y-4">
          <% @recent_broker_applications.each do |broker_application| %>
            <%= link_to broker_application_path(broker_application), class: "block rounded-2xl border border-slate-200 px-5 py-4 transition hover:border-sky-300 hover:bg-sky-50/50" do %>
              <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                <div>
                  <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-700"><%= broker_application.application_reference %></p>
                  <p class="mt-2 text-lg font-semibold text-slate-900"><%= [broker_application.broker_applicant&.first_name, broker_application.broker_applicant&.surname].compact.join(" ") %></p>
                  <p class="mt-1 text-sm text-slate-500"><%= broker_application.broker_vehicle&.make_model %> · <%= broker_application.broker_vehicle&.registration %></p>
                </div>

                <div class="text-sm text-slate-500">
                  Captured <%= time_ago_in_words(broker_application.created_at) %> ago
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="mt-6 rounded-2xl border border-dashed border-slate-300 px-5 py-8 text-center text-sm text-slate-500">
          No broker applications captured yet. Start with AF-2026-00417 to create the first structured deal record.
        </div>
      <% end %>
    </div>

    <div class="rounded-3xl border border-slate-200 bg-slate-950 px-8 py-8 text-white shadow-sm">
      <h2 class="text-2xl font-semibold">Immediate objective</h2>
      <p class="mt-3 text-sm leading-6 text-slate-300">Minimize the work before payout review even begins. Once the broker application is captured cleanly, the next slice can reconcile these fields against the rest of the deal pack and only interrupt humans when something genuinely disagrees.</p>
    </div>
  </div>
</section>
