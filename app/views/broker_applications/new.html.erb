<section class="space-y-8">
  <div class="rounded-3xl border border-slate-200 bg-white px-8 py-10 shadow-sm">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl space-y-3">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-700">Broker Intake</p>
        <h1 class="text-4xl font-semibold tracking-tight text-slate-900">Capture the originating application before reconciliation starts.</h1>
        <p class="text-lg text-slate-600">This prototype turns the broker submission into a structured deal record so later checks can compare fields instead of forcing reviewers to re-read every document.</p>
      </div>

      <%= link_to "Back to dashboard", dashboard_path, class: "inline-flex items-center justify-center rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900" %>
    </div>
  </div>

  <%= render "form", broker_application: @broker_application %>
</section>
