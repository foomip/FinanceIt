<section class="space-y-8">
  <% hp_agreement_status_classes = if @broker_application.broker_hp_agreement.present?
    "border-emerald-200 bg-emerald-50 text-emerald-900"
  else
    "border-amber-200 bg-amber-50 text-amber-900"
  end %>
  <% purchase_invoice_status_classes = if @broker_application.broker_purchase_invoice.present?
    "border-emerald-200 bg-emerald-50 text-emerald-900"
  elsif @broker_application.broker_hp_agreement.present?
    "border-sky-200 bg-sky-50 text-sky-900"
  else
    "border-slate-200 bg-slate-50 text-slate-700"
  end %>

  <div class="rounded-3xl border border-emerald-200 bg-emerald-50 px-8 py-8 shadow-sm">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-700">Broker Application Captured</p>
        <h1 class="mt-2 text-4xl font-semibold tracking-tight text-slate-900"><%= @broker_application.application_reference %></h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-700">The originating broker submission is now stored as structured deal data. This becomes the baseline for later document reconciliation and exception handling.</p>
      </div>

      <div class="flex gap-3">
        <%= link_to "Capture another", new_broker_application_path, class: "inline-flex items-center justify-center rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800" %>
        <% if @broker_application.broker_hp_agreement.present? %>
          <%= link_to "View HP agreement", broker_application_hp_agreement_path(@broker_application), class: "inline-flex items-center justify-center rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900" %>
        <% else %>
          <%= link_to "Start HP agreement", new_broker_application_hp_agreement_path(@broker_application), class: "inline-flex items-center justify-center rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900" %>
        <% end %>
        <% if @broker_application.broker_purchase_invoice.present? %>
          <%= link_to "View purchase invoice", broker_application_purchase_invoice_path(@broker_application), class: "inline-flex items-center justify-center rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900" %>
        <% elsif @broker_application.broker_hp_agreement.present? %>
          <%= link_to "Start purchase invoice", new_broker_application_purchase_invoice_path(@broker_application), class: "inline-flex items-center justify-center rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900" %>
        <% end %>
        <%= link_to "Return to dashboard", dashboard_path, class: "inline-flex items-center justify-center rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:text-slate-900" %>
      </div>
    </div>
  </div>

  <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_20rem_20rem] lg:items-start">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-sky-700">Process flow</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-900">Move from intake to two downstream document snapshots without re-keying the whole deal.</h2>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">The HP agreement remains the next capture step. Once that is ready, the purchase invoice becomes available so the prototype can compare dealer-supplied values against the original intake and agreement snapshot later.</p>
      </div>

      <div class="rounded-2xl border <%= hp_agreement_status_classes %> px-5 py-4 text-sm">
        <p class="font-semibold"><%= @broker_application.broker_hp_agreement.present? ? 'HP agreement prepared' : 'HP agreement still needed' %></p>
        <p class="mt-2"><%= @broker_application.broker_hp_agreement.present? ? 'This deal already has the follow-on agreement snapshot ready for later checks.' : 'Start the next step to add term and first payment date while carrying the shared deal fields forward automatically.' %></p>
      </div>

      <div class="rounded-2xl border <%= purchase_invoice_status_classes %> px-5 py-4 text-sm">
        <p class="font-semibold">
          <%= if @broker_application.broker_purchase_invoice.present?
            'Purchase invoice captured'
          elsif @broker_application.broker_hp_agreement.present?
            'Purchase invoice ready to capture'
          else
            'Purchase invoice locked until step 2'
          end %>
        </p>
        <p class="mt-2">
          <%= if @broker_application.broker_purchase_invoice.present?
            'The dealer invoice snapshot is stored and ready to feed later mismatch detection.'
          elsif @broker_application.broker_hp_agreement.present?
            'Capture the dealer invoice next, using the application and agreement as context rather than starting from zero.'
          else
            'Complete the HP agreement first so the invoice step follows the same trust-the-baseline workflow.'
          end %>
        </p>
      </div>
    </div>
  </section>

  <div class="grid gap-6 xl:grid-cols-3">
    <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-slate-900">Applicant</h2>
      <dl class="mt-5 space-y-4 text-sm text-slate-600">
        <div>
          <dt class="font-medium text-slate-900">Name</dt>
          <dd class="mt-1"><%= [@broker_application.broker_applicant.first_name, @broker_application.broker_applicant.surname].join(" ") %></dd>
        </div>
        <div>
          <dt class="font-medium text-slate-900">Date of birth</dt>
          <dd class="mt-1"><%= @broker_application.broker_applicant.date_of_birth.strftime("%d/%m/%Y") %></dd>
        </div>
        <div>
          <dt class="font-medium text-slate-900">Address</dt>
          <dd class="mt-1"><%= @broker_application.broker_applicant.address_line_1 %>, <%= @broker_application.broker_applicant.city %>, <%= @broker_application.broker_applicant.postcode %></dd>
        </div>
        <div>
          <dt class="font-medium text-slate-900">Employment</dt>
          <dd class="mt-1"><%= @broker_application.broker_applicant.employment_status_label %></dd>
        </div>
        <div>
          <dt class="font-medium text-slate-900">Time at current employer</dt>
          <dd class="mt-1"><%= pluralize(@broker_application.broker_applicant.time_at_current_employer_years, "year") %></dd>
        </div>
      </dl>
    </article>

    <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-slate-900">Vehicle</h2>
      <dl class="mt-5 space-y-4 text-sm text-slate-600">
        <div>
          <dt class="font-medium text-slate-900">Make / model</dt>
          <dd class="mt-1"><%= @broker_application.broker_vehicle.make_model %></dd>
        </div>
        <div>
          <dt class="font-medium text-slate-900">Year</dt>
          <dd class="mt-1"><%= @broker_application.broker_vehicle.year %></dd>
        </div>
        <div>
          <dt class="font-medium text-slate-900">Registration</dt>
          <dd class="mt-1"><%= @broker_application.broker_vehicle.registration %></dd>
        </div>
        <div>
          <dt class="font-medium text-slate-900">Mileage</dt>
          <dd class="mt-1"><%= number_with_delimiter(@broker_application.broker_vehicle.mileage) %></dd>
        </div>
      </dl>
    </article>

    <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold text-slate-900">Finance</h2>
      <dl class="mt-5 space-y-4 text-sm text-slate-600">
        <div>
          <dt class="font-medium text-slate-900">Cash price</dt>
          <dd class="mt-1"><%= number_to_currency(@broker_application.broker_finance.cash_price) %></dd>
        </div>
        <div>
          <dt class="font-medium text-slate-900">Deposit</dt>
          <dd class="mt-1"><%= number_to_currency(@broker_application.broker_finance.deposit) %></dd>
        </div>
        <div>
          <dt class="font-medium text-slate-900">Amount to finance</dt>
          <dd class="mt-1"><%= number_to_currency(@broker_application.broker_finance.amount_to_finance) %></dd>
        </div>
        <div>
          <dt class="font-medium text-slate-900">Monthly payment</dt>
          <dd class="mt-1"><%= number_to_currency(@broker_application.broker_finance.monthly_payment) %></dd>
        </div>
        <div>
          <dt class="font-medium text-slate-900">Total amount payable</dt>
          <dd class="mt-1"><%= number_to_currency(@broker_application.broker_finance.total_amount_payable) %></dd>
        </div>
        <div>
          <dt class="font-medium text-slate-900">APR</dt>
          <dd class="mt-1"><%= number_with_precision(@broker_application.broker_finance.apr, precision: 2) %>%</dd>
        </div>
        <div>
          <dt class="font-medium text-slate-900">Glass's Guide retail</dt>
          <dd class="mt-1"><%= number_to_currency(@broker_application.broker_finance.glass_guide_retail_estimate) %></dd>
        </div>
      </dl>
    </article>
  </div>
</section>
